{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Main",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/src",
                "-L${workspaceFolder}/lib",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/core/glfw_context.cpp",
                "${workspaceFolder}/src/core/window.cpp",
                "${workspaceFolder}/src/core/input.cpp",
                "${workspaceFolder}/src/glad.c",
                "-lglfw3dll",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: g++"
        },
        {
            "type": "shell",
            "label": "Build Example",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++20",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/src",
                "-L${workspaceFolder}/lib",
                "${workspaceFolder}/src/examples/${input:example}/main.cpp",
                "${workspaceFolder}/src/core/glfw_context.cpp",
                "${workspaceFolder}/src/core/window.cpp",
                "${workspaceFolder}/src/core/input.cpp",
                "${workspaceFolder}/src/glad.c",
                "-lglfw3dll",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/${input:example}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: g++"
        }
    ],
    "inputs": [
        {
            "id": "example",
            "type": "pickString",
            "description": "Example to build",
            "options": [
                "triangle",
                "ball_collisions",
                "bouncing_ball",
                "mass_spring_square",
                "ragdoll"
            ],
            "default": "triangle"
        }
    ]
}
